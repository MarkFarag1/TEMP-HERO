#include <LiquidCrystal.h>
#include <DHT.h>

#define Type DHT11

int rs = 7;
int en = 8;
int d4 = 9;
int d5 = 10;
int d6 = 11;
int d7 = 12;

LiquidCrystal lcd(rs, en, d4, d5, d6, d7);


int sensePin = 2;

DHT HT(sensePin, Type);


float humidity = 0;
float tempC = 0;
float tempF = 0;


int startDelay = 500;
int loopDelay = 500;

void setup()
{
  Serial.begin(9600);

  HT.begin();

  lcd.begin(16, 2);

  delay(startDelay);
}

void loop()
{

  humidity = HT.readHumidity();
  tempC = HT.readTemperature();
  tempF = HT.readTemperature(true);

  
  lcd.setCursor(0, 0);
  lcd.print("Temp F: ");
  lcd.print(tempF);

  lcd.setCursor(0, 1);
  lcd.print("Hum: ");
  lcd.print(humidity);
  lcd.print("%");

  Serial.print("Humidity = ");
  Serial.print(humidity);
  Serial.print(" %   ");

  Serial.print("Temp = ");
  Serial.print(tempC);
  Serial.print(" C   ");

  Serial.print(tempF);
  Serial.println(" F");

  delay(loopDelay);

  lcd.clear();
}
